---
import '@fontsource-variable/geist-mono/index.css'

import Analytics from '@vercel/analytics/astro'
import '../styles/global.css'
import '../components/toasts/toast.css'

import { SITE } from '../data/site'
import { DEFAULT_EFFECT_CLASS } from '../data/effects'
import { THEME_KEY } from '../lib/theme'

interface Props {
  title?: string
  description?: string
  noindex?: boolean
  effectClass?: string
}

const {
  title = SITE.title,
  description = SITE.description,
  noindex = false,
  effectClass = DEFAULT_EFFECT_CLASS
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url)
const isHome = canonical.pathname === '/' || canonical.pathname === '/index.html'
const pageUrl = canonical.href
const markdownPath = isHome ? '/index.md' : `${canonical.pathname.replace(/\/$/, '')}.md`

const website = {
  '@type': 'WebSite',
  '@id': new URL('/#website', SITE.url).href,
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: SITE.locale
}

const software = {
  '@type': 'SoftwareApplication',
  name: SITE.name,
  alternateName: ['viewfx', 'View FX'],
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  url: SITE.url,
  description: SITE.description,
  keywords: 'ViewFX, Tailwind CSS plugin, theme toggle, View Transitions',
  image: SITE.image,
  sameAs: [SITE.repo, SITE.npm],
  downloadUrl: SITE.npm,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD'
  },
  author: {
    '@type': 'Person',
    name: SITE.author.name,
    url: SITE.author.url
  }
}

const webPage = {
  '@type': 'WebPage',
  name: title,
  description,
  url: pageUrl,
  inLanguage: SITE.locale,
  isPartOf: { '@id': website['@id'] }
}

const crumbNames: Record<string, string> = {
  '/playground': 'Playground',
  '/playground/': 'Playground',
  '/gif': 'GIF studio',
  '/gif/': 'GIF studio'
}
const crumbName = crumbNames[canonical.pathname]
const breadcrumb = crumbName
  ? {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: new URL('/', SITE.url).href
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: crumbName,
          item: pageUrl
        }
      ]
    }
  : null

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [website, webPage, ...(isHome ? [software] : []), ...(breadcrumb ? [breadcrumb] : [])]
}

/**
 * Resolves the theme before first paint so it does not flash. Inline and
 * therefore unbundled, which is why the storage key is interpolated from the
 * module that owns it rather than repeated as a literal.
 */
const bootstrap = `(() => {
  const el = document.documentElement
  try {
    const theme = localStorage.getItem('${THEME_KEY}')
    const mode = theme === 'light' || theme === 'dark' || theme === 'auto' ? theme : 'auto'
    const dark = mode === 'dark' || (mode === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches)
    el.classList.toggle('dark', dark)
    el.dataset.themeMode = mode
  } catch {}
})()`
---

<!doctype html>
<html
  lang={SITE.locale}
  data-theme-mode="auto"
  class={`${effectClass} scrollbar-thin scrollbar-thumb-accent scrollbar-track-paper`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{title}</title>
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="author" content={SITE.author.name} />
    <meta name="color-scheme" content="light dark" />

    <!-- Canonical + hreflang -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={new URL(markdownPath, SITE.url)} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f8f6f1" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SITE.ogLocale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={SITE.image} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content={String(SITE.imageWidth)} />
    <meta property="og:image:height" content={String(SITE.imageHeight)} />
    <meta property="og:image:alt" content={SITE.imageAlt} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SITE.image} />
    <meta name="twitter:image:alt" content={SITE.imageAlt} />
    {SITE.twitter && <meta name="twitter:site" content={SITE.twitter} />}

    <script is:inline set:html={bootstrap} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>

  <body id="top" class="min-h-dvh font-display antialiased">
    <a
      class="sr-only font-semibold focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-3 focus:text-accent-ink focus:no-underline focus:outline-2 focus:outline-offset-2 focus:outline-white"
      href="#main">Skip to main content</a>

    <slot />

    <div id="live-region" class="sr-only" role="status" aria-live="polite"></div>
    <div
      id="site-toasts"
      class="pointer-events-none fixed inset-x-0 top-2 z-[100] flex flex-col items-center gap-3 px-4 sm:top-2.5"
      aria-live="polite"
      aria-atomic="true"
    ></div>

    <script>
      import { initTheme } from '../lib/theme'
      import { initSectionNav } from '../lib/section-nav'
      initTheme()
      initSectionNav()
    </script>
    <Analytics />
  </body>
</html>
