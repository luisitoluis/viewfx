---
import Logo from '@components/ui/Logo.astro'
import ArrowRightIcon from '@components/icons/arrow-right.astro'
import CopyIcon from '@components/icons/copy.astro'
import PackageMark from '@components/ui/PackageMark.astro'
import { EFFECTS } from '@data/effects'
import { SITE } from '@data/site'
import { AGENT_INSTALL_PROMPT } from '@data/agent-prompt'
import { highlight } from '@lib/highlight'
import { version } from '@root/package.json'

const PACKAGE_MANAGERS = [
  { name: 'npm', command: `npm install ${SITE.package}` },
  { name: 'pnpm', command: `pnpm add ${SITE.package}` },
  { name: 'yarn', command: `yarn add ${SITE.package}` },
  { name: 'bun', command: `bun add ${SITE.package}` }
] as const

const IMPORT_V4 = `@import 'tailwindcss';
@import '${SITE.package}';`

const IMPORT_V3 = `/** @type {import('tailwindcss').Config} */
module.exports = {
  plugins: [
    require('${SITE.package}')
  ]
}`
---

<section id="installation" class="relative z-10 mb-24 scroll-mt-20">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-start gap-10 lg:grid-cols-2 lg:items-end lg:gap-12 xl:gap-16">
      <div class="text-left">
        <div class="motion-safe:animate-fade-up mb-5 flex items-center gap-3 sm:mb-6 sm:gap-4 [animation-delay:100ms]">
          <Logo
            class="aspect-square size-11 shrink-0 sm:size-12"
            iconClass="size-6 animate-float-subtle sm:size-7"
          />
          <div class="min-w-0">
            <h1
              class="text-3xl font-bold tracking-tight text-ink sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]"
            >
              View<span class="text-accent-text">FX</span>
            </h1>
            <p class="mt-1 flex items-center gap-3 font-mono text-xs tracking-wide text-ink-3">
              <span class="hero-dot" aria-hidden="true">
                <span class="hero-dot__ring"></span>
                <span class="hero-dot__ring hero-dot__ring--late"></span>
                <span class="hero-dot__core"></span>
              </span>
              v{version}
            </p>
          </div>
        </div>

        <p
          class="motion-safe:animate-fade-up mb-6 max-w-md text-base leading-relaxed text-ink-2 sm:text-lg [animation-delay:200ms]"
        >
          {EFFECTS.length}+ ready-to-use theme transitions for Tailwind CSS. Zero config, one class
          on{' '}
          <em class="font-normal text-accent-text italic">&lt;html&gt;</em>.
        </p>

        <div
          class="motion-safe:animate-fade-up mb-8 flex flex-wrap items-center gap-3 sm:mb-10 [animation-delay:200ms]"
          data-copy-scope
        >
          <a
            href="/playground"
            class="group inline-flex min-h-11 items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-accent/25 transition-all hover:bg-[color-mix(in_oklab,var(--accent)_82%,black)] hover:shadow-accent/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
          >
            Open Playground
            <ArrowRightIcon
              size={16}
              class="stroke-2 transition-transform group-hover:translate-x-0.5"
            />
          </a>
          <button
            type="button"
            class="group inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-full border border-line-strong bg-paper/80 px-5 py-2.5 text-sm font-semibold text-ink shadow-sm transition-all hover:border-accent/40 hover:text-accent-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
            data-copy="#agent-install-prompt"
            data-toast="Agent install prompt copied!"
            aria-label="Copy install prompt for Claude Code and similar agents"
          >
            <CopyIcon
              size={16}
              class="stroke-2 opacity-70 transition-opacity group-hover:opacity-100"
            />
            <span data-copy-label>Install from prompt</span>
          </button>
          <pre id="agent-install-prompt" hidden>{AGENT_INSTALL_PROMPT}</pre>
        </div>
      </div>

      <div class="motion-safe:animate-fade-up flex w-full flex-col gap-3 [animation-delay:300ms]">
        <div data-copy-scope class="install-card">
          <div class="install-card__bar">
            <div class="install-card__tabs" role="group" aria-label="Package manager">
              {
                PACKAGE_MANAGERS.map((pm, index) => (
                  <button
                    type="button"
                    class="install-tab"
                    data-pm
                    data-command={pm.command}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                  >
                    <span class="install-tab__mark">
                      <PackageMark name={pm.name} />
                    </span>
                    {pm.name}
                  </button>
                ))
              }
            </div>
            <button
              type="button"
              class="install-card__copy cursor-pointer rounded-[0.625rem] border border-transparent data-[state=copied]:border-accent data-[state=copied]:text-accent-text"
              data-copy="#install-command"
              data-toast="Command copied to clipboard!"
              aria-label="Copy install command"
            >
              <CopyIcon size={15} />
              <span class="sr-only" data-copy-label>Copy</span>
            </button>
          </div>
          <p class="install-card__body">
            <span class="install-prompt" aria-hidden="true">$</span>
            <code id="install-command">{PACKAGE_MANAGERS[0].command}</code>
          </p>
        </div>

        <div data-copy-scope class="install-card">
          <div class="install-card__bar">
            <div class="install-card__tabs" role="group" aria-label="Tailwind version">
              <button type="button" class="install-tab" data-tw-version="v4" aria-pressed="true">
                Tailwind v4
              </button>
              <button type="button" class="install-tab" data-tw-version="v3" aria-pressed="false">
                Tailwind v3
              </button>
            </div>
            <button
              type="button"
              class="install-card__copy cursor-pointer rounded-[0.625rem] border border-transparent data-[state=copied]:border-accent data-[state=copied]:text-accent-text"
              data-copy="#install-v4"
              data-toast="Configuration copied to clipboard!"
              data-tw-copy
              aria-label="Copy usage snippet"
            >
              <CopyIcon size={15} />
              <span class="sr-only" data-copy-label>Copy</span>
            </button>
          </div>
          <pre id="install-v4" class="install-card__body code" set:html={highlight(IMPORT_V4, 'css')} />
          <pre
            id="install-v3"
            class="install-card__body code"
            hidden
            set:html={highlight(IMPORT_V3, 'js')}
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initPackageManagers() {
    const command = document.getElementById('install-command')
    const buttons = Array.from(document.querySelectorAll('[data-pm]'))
    if (!command || buttons.length === 0) return

    for (const button of buttons) {
      button.addEventListener('click', () => {
        if (!(button instanceof HTMLElement)) return
        const next = button.dataset.command
        if (next) command.textContent = next

        for (const other of buttons) {
          other.setAttribute('aria-pressed', String(other === button))
        }
      })
    }
  }

  function initTailwindVersions() {
    const buttons = Array.from(document.querySelectorAll('[data-tw-version]'))
    const copy = document.querySelector('[data-tw-copy]')
    const v4 = document.getElementById('install-v4')
    const v3 = document.getElementById('install-v3')
    if (!copy || !v4 || !v3 || buttons.length === 0) return

    for (const button of buttons) {
      button.addEventListener('click', () => {
        if (!(button instanceof HTMLElement) || !(copy instanceof HTMLElement)) return
        const version = button.dataset.twVersion
        v4.hidden = version !== 'v4'
        v3.hidden = version !== 'v3'
        copy.dataset.copy = version === 'v3' ? '#install-v3' : '#install-v4'

        for (const other of buttons) {
          other.setAttribute('aria-pressed', String(other === button))
        }
      })
    }
  }

  initPackageManagers()
  initTailwindVersions()
</script>

<style>
  .install-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    background: var(--surface);
    text-align: left;
  }

  .install-card__bar {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.5rem 0.5rem 0.625rem;
  }

  .install-card__tabs {
    display: flex;
    min-width: 0;
    flex: 1;
    align-items: center;
    gap: 0.125rem;
    overflow-x: auto;
  }

  .install-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2rem;
    padding: 0.25rem 0.7rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-2);
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
  }

  @media (width < 40rem) {
    .install-tab {
      padding: 0.25rem 0.5rem;
    }
  }

  .install-tab:hover {
    color: var(--ink);
  }

  .install-tab[aria-pressed='true'] {
    background: var(--paper);
    color: var(--ink);
  }

  .install-tab__mark {
    display: block;
    width: 0.9rem;
    height: 0.9rem;
    flex-shrink: 0;
  }

  .install-tab__mark :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .install-card__copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-width: 2rem;
    min-height: 2rem;
    padding: 0;
    color: var(--ink-3);
    cursor: pointer;
  }

  .install-card__copy:hover {
    background: var(--inset);
    color: var(--ink);
  }

  .install-card__body {
    margin: 0;
    overflow-x: auto;
    border-top: 1px solid var(--line);
    padding: 1rem 1.15rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--ink);

    @media (width >= 40rem) {
      font-size: 0.875rem;
    }
  }

  .install-prompt {
    margin-right: 0.55rem;
    color: var(--ink-3);
  }

  .install-card :global(.t-com) {
    color: var(--ink-3);
    font-style: italic;
  }

  .install-card :global(.t-at) {
    color: #e6c35c;
    font-weight: 500;
  }

  .install-card :global(.t-str) {
    color: #e88848;
  }

  .install-card :global(.t-sel),
  .install-card :global(.t-var) {
    color: var(--accent-text);
    font-weight: 500;
  }

  .install-card :global(.t-prop) {
    color: var(--ink);
    font-weight: 500;
  }

  .install-card :global(.t-fn) {
    color: var(--ink-2);
  }

  .install-card :global(.t-num) {
    color: var(--ink);
  }

  .hero-dot {
    position: relative;
    display: inline-flex;
    width: 0.55rem;
    height: 0.55rem;
    flex-shrink: 0;
  }

  .hero-dot__core,
  .hero-dot__ring {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: var(--accent);
  }

  .hero-dot__core {
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--accent) 40%, transparent),
      0 0 12px color-mix(in oklab, var(--accent) 80%, transparent);
  }

  .hero-dot__ring {
    animation: hero-dot-pulse 1.7s cubic-bezier(0.15, 0.7, 0.3, 1) infinite;
  }

  .hero-dot__ring--late {
    animation-delay: 0.55s;
  }

  @keyframes hero-dot-pulse {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    100% {
      transform: scale(4.2);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-dot__ring {
      animation: none;
      display: none;
    }
  }
</style>
