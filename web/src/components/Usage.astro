---
import CodeBlock from '@components/CodeBlock.astro'
import { SITE } from '@data/site'

interface Step {
  title: string
  body: string
  filename: string
  language: string
  code: string
}

const STEPS: Step[] = [
  {
    title: 'Import the plugin',
    body: `On Tailwind v4, import ViewFX next to Tailwind in your global stylesheet. On v3, add require("${SITE.package}") to plugins in tailwind.config.js.`,
    filename: 'global.css',
    language: 'css',
    code: `@import 'tailwindcss';
@import '${SITE.package}';`
  },
  {
    title: 'Put the effect on html',
    body: 'Each effect is a utility class. Apply it to the document element, then wrap your theme toggle in startViewTransition.',
    filename: 'index.html',
    language: 'html',
    code: `<html class="dark circle-duration-1000-delay-300">`
  },
  {
    title: 'Wrap the theme change',
    body: 'The browser snapshots before and after, then runs the CSS between the two. Browsers without the API just switch instantly. Reduced motion is honoured by the plugin.',
    filename: 'theme.js',
    language: 'js',
    code: `function switchTheme() {
  document.documentElement.classList.toggle('dark')
}

if (document.startViewTransition) {
  document.startViewTransition(switchTheme)
} else {
  switchTheme()
}`
  }
]
---

<section id="usage" class="border-t border-line py-20 sm:py-24" aria-labelledby="usage-heading">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <p class="font-mono text-[0.6875rem] leading-none tracking-[0.14em] text-ink-3 uppercase">02 — Usage</p>
    <h2 id="usage-heading" class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">
      Install, class, one line of JavaScript
    </h2>

    <ol class="mt-12 grid gap-10 lg:grid-cols-3 lg:gap-8">
      {
        STEPS.map((step, index) => (
          <li class="flex flex-col gap-4">
            <p class="flex items-center gap-3">
              <span
                class="grid size-7 shrink-0 place-items-center rounded-full border border-line font-mono text-xs tabular-nums"
                aria-hidden="true"
              >
                {index + 1}
              </span>
              <span class="text-lg font-semibold tracking-tight">{step.title}</span>
            </p>

            <p class="text-sm leading-relaxed text-pretty text-ink-2">{step.body}</p>

            <CodeBlock
              code={step.code}
              language={step.language}
              filename={step.filename}
              class="mt-auto"
            />
          </li>
        ))
      }
    </ol>
  </div>
</section>
