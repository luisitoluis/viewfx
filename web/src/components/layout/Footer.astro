---
import Logo from '../ui/Logo.astro'
import GithubIcon from '../icons/github.astro'
import { SITE } from '../../data/site'
import { EFFECTS } from '../../data/effects'

const currentYear = new Date().getFullYear()
const isHome =
  Astro.url.pathname === '/' || Astro.url.pathname === '/index.html'
const section = (id: string) => (isHome ? `#${id}` : `/#${id}`)

const columns = [
  {
    title: 'Documentation',
    links: [
      { name: 'Installation', href: isHome ? '#installation' : '/' },
      { name: 'Playground', href: '/playground' },
      { name: 'GIF studio', href: '/gif' },
      { name: 'Effect Collection', href: section('palette') },
      { name: 'FAQ', href: section('faq') }
    ]
  },
  {
    title: 'Community',
    links: [
      { name: 'Contributors', href: `${SITE.repo}/graphs/contributors` },
      { name: 'GitHub Issues', href: `${SITE.repo}/issues` },
      { name: 'GitHub PR', href: `${SITE.repo}/pulls` }
    ]
  },
  {
    title: 'Links',
    links: [
      { name: 'npm Package', href: SITE.npm },
      { name: 'View Transitions API', href: 'https://developer.mozilla.org/en-US/docs/Web/API/View_Transitions_API' }
    ]
  }
]

const social = [
  {
    name: 'GitHub account',
    href: SITE.repo,
    icon: 'github'
  },
  {
    name: `${SITE.author.name} website`,
    href: SITE.author.url,
    icon: 'site'
  }
]
---

<footer class="relative z-0 overflow-hidden bg-inset" role="contentinfo">
  <div
    class="pointer-events-none h-24 bg-linear-to-b from-paper via-paper/80 to-transparent sm:h-32"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto w-full max-w-6xl p-4 py-6 sm:px-6 lg:px-8 lg:py-8">
    <div class="md:flex md:justify-between">
      <div class="mb-6 max-w-sm md:mb-0">
        <div class="group flex w-fit items-center gap-3">
          <Logo
            class="size-8 group-hover:scale-110 group-hover:rotate-3 group-hover:shadow-accent/40"
            iconClass="size-5 animate-float-subtle group-hover:animate-pulse"
          />
          <span class="self-center text-2xl font-bold tracking-tight whitespace-nowrap text-ink transition-colors group-hover:text-accent-text">
            View<span class="text-accent-text">FX</span>
          </span>
        </div>
        <p class="mt-4 text-base leading-relaxed text-ink-2">
          Free Tailwind CSS plugin for theme toggles, with {EFFECTS.length} view-transition
          effects. Open source, and built to copy one class onto
          {' '}
          <code class="font-mono text-[0.95em]">&lt;html&gt;</code>.
        </p>
        <div class="mt-4 flex gap-3">
          {
            social.map((item) => (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex size-11 min-h-11 min-w-11 items-center justify-center rounded-full bg-paper text-ink-3 shadow-sm ring-1 ring-line transition-all hover:text-ink hover:ring-line-strong focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              >
                {item.icon === 'github' ? (
                  <GithubIcon size={20} class="size-5" />
                ) : (
                  <svg
                    class="size-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="9" />
                    <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" />
                  </svg>
                )}
                <span class="sr-only">{item.name}, opens in a new tab</span>
              </a>
            ))
          }
        </div>
      </div>
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 sm:gap-6">
        {
          columns.map((column) => (
            <div>
              <h2 class="mb-6 text-sm font-semibold tracking-wide text-ink uppercase">
                {column.title}
              </h2>
              <ul class="font-medium text-ink-3">
                {column.links.map((link, index) => {
                  const isExternal = link.href.startsWith('http')
                  return (
                    <li class:list={[index < column.links.length - 1 && 'mb-4']}>
                      <a
                        href={link.href}
                        class="hover:text-ink"
                        {...(isExternal
                          ? { target: '_blank', rel: 'noopener noreferrer' }
                          : {})}
                      >
                        {link.name}
                        {isExternal && <span class="sr-only"> (opens in a new tab)</span>}
                      </a>
                    </li>
                  )
                })}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
    <hr class="my-6 border-line sm:mx-auto lg:my-8" />
    <div class="flex flex-col gap-3 text-sm text-ink-3 sm:flex-row sm:items-center sm:justify-between">
        <span>
          © {currentYear} {SITE.name}. MIT License.
        </span>
        <p class="flex flex-wrap items-center gap-2">
          <span>Created with</span>
          <span>by</span>
          <a
            href={SITE.author.url}
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold text-ink hover:text-accent-text"
          >
            {SITE.author.name}
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </p>
    </div>
  </div>
</footer>
