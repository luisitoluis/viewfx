---
import Logo from '@components/ui/Logo.astro'
import GithubIcon from '@components/icons/github.astro'
import ToggleTheme from '@components/ui/ToggleTheme.astro'
import Enlace from '@components/ui/Enlace.astro'
import { SITE } from '@data/site'

const isHome =
  Astro.url.pathname === '/' || Astro.url.pathname === '/index.html'
const isPlayground = Astro.url.pathname.startsWith('/playground')
const isGif = Astro.url.pathname.startsWith('/gif')
const section = (id: string) => (isHome ? `#${id}` : `/#${id}`)

const navLinkClass =
  'inline-flex items-center px-2 py-1 text-[13px] font-medium tracking-tight text-ink-3 transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent xl:px-2.5'

const mobileNavLinkClass =
  'block rounded-lg px-3 py-2.5 text-base font-medium text-ink-2 transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent'

const iconBtnClass =
  'inline-flex size-10 min-h-10 min-w-10 cursor-pointer items-center justify-center rounded-full text-ink-3 transition-colors hover:bg-inset hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent sm:size-11 sm:min-h-11 sm:min-w-11'
---

<style>
  .header-scroll {
    --header-opacity: 0;
    background: color-mix(in oklab, var(--paper) calc(var(--header-opacity) * 82%), transparent);
    border-color: color-mix(in oklab, var(--line) calc(var(--header-opacity) * 100%), transparent);
    backdrop-filter: blur(calc(var(--header-opacity) * 10px));
    -webkit-backdrop-filter: blur(calc(var(--header-opacity) * 10px));
  }

  .logo-scroll {
    --logo-opacity: 0;
    opacity: var(--logo-opacity);
    transform: translateY(calc((1 - var(--logo-opacity)) * 10px));
  }

  .logo-scroll[aria-hidden='true'] {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-scroll {
      transform: none;
    }
  }

  .header-menu-icon {
    position: relative;
    display: block;
    width: 1rem;
    height: 0.75rem;
  }

  .header-menu-icon span {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
    transition:
      transform 0.35s var(--expo-out, ease-out),
      opacity 0.2s ease;
  }

  .header-menu-icon span:nth-child(1) {
    top: 0;
  }

  .header-menu-icon span:nth-child(2) {
    top: 5px;
  }

  .header-menu-icon span:nth-child(3) {
    top: 10px;
  }

  #menu-btn[aria-expanded='true'] .header-menu-icon span:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }

  #menu-btn[aria-expanded='true'] .header-menu-icon span:nth-child(2) {
    opacity: 0;
  }

  #menu-btn[aria-expanded='true'] .header-menu-icon span:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }

  #menu {
    display: grid;
    grid-template-rows: 0fr;
    border-top: 1px solid transparent;
    background: var(--paper);
    transition:
      grid-template-rows 0.42s var(--expo-out, ease-out),
      border-color 0.32s ease;
  }

  #menu[data-open] {
    grid-template-rows: 1fr;
    border-top-color: var(--line);
  }

  #menu .menu-panel {
    overflow: hidden;
    min-height: 0;
  }

  #menu[data-open] .menu-panel a {
    animation: fade-in-up 0.4s var(--expo-out, ease-out) both;
  }

  #menu[data-open] .menu-panel a:nth-child(1) {
    animation-delay: 40ms;
  }

  #menu[data-open] .menu-panel a:nth-child(2) {
    animation-delay: 85ms;
  }

  #menu[data-open] .menu-panel a:nth-child(3) {
    animation-delay: 130ms;
  }

  #menu[data-open] .menu-panel a:nth-child(4) {
    animation-delay: 175ms;
  }

  @media (min-width: 1024px) {
    #menu {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-menu-icon span,
    #menu {
      transition: none;
    }

    #menu[data-open] .menu-panel a {
      animation: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('menu-btn')
  const menu = document.getElementById('menu')

  const isMenuOpen = () => btn?.getAttribute('aria-expanded') === 'true'

  const setMenuOpen = (open: boolean) => {
    if (!btn || !menu) return

    menu.toggleAttribute('data-open', open)
    menu.toggleAttribute('inert', !open)
    menu.setAttribute('aria-hidden', String(!open))
    btn.setAttribute('aria-expanded', String(open))
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu')
    document.body.classList.toggle(
      'overflow-hidden',
      open && window.matchMedia('(max-width: 1023px)').matches
    )

    if (open) {
      header?.style.setProperty('--header-opacity', '1')
      const firstLink = menu.querySelector<HTMLElement>('a[href]')
      firstLink?.focus()
    } else {
      handleScroll()
    }
  }

  if (btn && menu) {
    btn.addEventListener('click', () => {
      setMenuOpen(!isMenuOpen())
    })

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isMenuOpen()) {
        if (window.matchMedia('(max-width: 1023px)').matches) {
          setMenuOpen(false)
          btn.focus()
        }
      }
    })

    menu.querySelectorAll('a[href]').forEach((link) => {
      link.addEventListener('click', () => {
        if (window.matchMedia('(max-width: 1023px)').matches) {
          setMenuOpen(false)
        }
      })
    })
  }

  const logoContainer = document.getElementById('logo-container')
  const header = document.getElementById('header')

  const handleScroll = () => {
    if (isMenuOpen()) {
      header?.style.setProperty('--header-opacity', '1')
      return
    }
    const scrollY = window.scrollY
    const progress = Math.min(scrollY / 100, 1)
    const isLogoInteractive = progress > 0.05

    header?.style.setProperty('--header-opacity', String(progress))

    logoContainer?.style.setProperty('--logo-opacity', String(progress))

    if (logoContainer) {
      if (isLogoInteractive) {
        logoContainer.removeAttribute('aria-hidden')
        logoContainer.removeAttribute('tabindex')
      } else {
        logoContainer.setAttribute('aria-hidden', 'true')
        logoContainer.setAttribute('tabindex', '-1')
      }
    }
  }

  window.addEventListener('scroll', handleScroll, { passive: true })
  handleScroll()
</script>

<header
  id="header"
  class="header-scroll fixed inset-x-0 top-0 z-50 border-b border-transparent"
>
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 flex h-14 items-center gap-3 sm:h-16 sm:gap-4">
    <a
      id="logo-container"
      href={isHome ? '#top' : '/'}
      aria-label={isHome ? `${SITE.name}, back to top` : `${SITE.name}, home`}
      aria-hidden="true"
      tabindex="-1"
      class="logo-scroll flex min-w-0 shrink-0 items-center gap-2 rounded-xl no-underline outline-none focus-visible:ring-2 focus-visible:ring-accent"
    >
      <Logo
        class="aspect-square size-8 shrink-0 sm:size-9"
        iconClass="size-5 sm:size-6 animate-float-subtle"
      />
      <span
        class="truncate text-base font-bold tracking-tight text-ink sm:text-lg"
        aria-hidden="true"
      >
        View<span class="text-accent-text">FX</span>
      </span>
    </a>

    <nav aria-label="Primary" class="ml-auto hidden min-w-0 items-center gap-0.5 lg:flex xl:gap-1">
      <a
        href="/playground"
        class={navLinkClass}
        aria-current={isPlayground ? 'page' : undefined}
      >
        Playground
      </a>
      <a
        href="/gif"
        class={navLinkClass}
        aria-current={isGif ? 'page' : undefined}
      >
        GIF
      </a>
      <Enlace href={section('palette')} class={navLinkClass}>
        <span class="xl:hidden">Effect</span>
        <span class="hidden xl:inline">Effect Collection</span>
      </Enlace>
      <Enlace href={section('faq')} class={navLinkClass}>FAQ</Enlace>
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-0.5 sm:gap-1 lg:ml-2">
      <ToggleTheme class={iconBtnClass} />
      <a
        href={SITE.repo}
        target="_blank"
        rel="noopener noreferrer"
        class={iconBtnClass}
        aria-label="Source on GitHub, opens in a new tab"
      >
        <GithubIcon size={17} />
      </a>
      <button
        id="menu-btn"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="menu"
        class:list={[iconBtnClass, 'lg:hidden']}
      >
        <span class="header-menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>

  <div
    id="menu"
    class="lg:hidden"
    aria-hidden="true"
    inert
  >
    <div class="menu-panel">
      <nav class="mx-auto flex w-full max-w-6xl flex-col gap-1 px-4 py-4 sm:px-6 lg:px-8" aria-label="Mobile">
        <a
          href="/playground"
          class={mobileNavLinkClass}
          aria-current={isPlayground ? 'page' : undefined}
        >
          Playground
        </a>
        <a
          href="/gif"
          class={mobileNavLinkClass}
          aria-current={isGif ? 'page' : undefined}
        >
          GIF studio
        </a>
        <Enlace href={section('palette')} class={mobileNavLinkClass}>Effect Collection</Enlace>
        <Enlace href={section('faq')} class={mobileNavLinkClass}>FAQ</Enlace>
      </nav>
    </div>
  </div>
</header>
