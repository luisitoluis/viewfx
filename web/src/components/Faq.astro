---
import { FAQ } from '@data/faq'

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: a
    }
  }))
}
---

<section id="faq" class="relative mt-32 mb-24" aria-labelledby="faq-heading">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <h2 id="faq-heading" class="mb-4 text-2xl font-semibold tracking-tight sm:text-4xl">
        Frequently Asked Questions
      </h2>
      <p class="text-lg text-balance text-ink-2">
        Everything you need to know about the ViewFX Tailwind plugin.
      </p>
    </div>

    <div class="mx-auto flex max-w-3xl flex-col gap-4">
      {
        FAQ.map(({ q, a }) => (
          <details class="faq-item group">
            <summary class="faq-item__summary">
              <span class="flex items-center justify-between gap-4">
                <span class="faq-item__question">{q}</span>
                <span class="faq-item__icon" aria-hidden="true">
                  +
                </span>
              </span>
            </summary>
            <div class="faq-item__body">
              <p class="faq-item__answer">{a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

<style>
  .faq-item {
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--surface) 60%, transparent);
    interpolate-size: allow-keywords;
    transition:
      border-color 0.35s var(--expo-out),
      box-shadow 0.45s var(--expo-out);
  }

  .faq-item[open] {
    border-color: var(--line-strong);
    box-shadow: 0 1rem 2rem -1rem color-mix(in oklab, var(--ink) 22%, transparent);
  }

  .faq-item__summary {
    cursor: pointer;
    list-style: none;
    border-radius: 0.5rem;
    text-align: left;
    font-size: 1rem;
    font-weight: 600;
  }

  .faq-item__summary::-webkit-details-marker,
  .faq-item__summary::marker {
    display: none;
    content: none;
  }

  .faq-item__summary:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }

  .faq-item__question {
    color: var(--ink);
    transition: color 0.3s;
  }

  .faq-item[open] .faq-item__question {
    color: var(--accent-text);
  }

  .faq-item__icon {
    flex-shrink: 0;
    color: var(--ink-3);
    transition: transform 0.45s var(--expo-out), color 0.3s;
  }

  .faq-item[open] .faq-item__icon {
    transform: rotate(45deg);
    color: var(--accent-text);
  }

  .faq-item__answer {
    margin: 0;
    padding-top: 0.75rem;
    color: var(--ink-2);
    font-size: 0.875rem;
    line-height: 1.625;
    text-wrap: pretty;
  }

  /* Open and close both animate: the UA keeps ::details-content in the tree. */
  .faq-item::details-content {
    display: block;
    overflow: hidden;
    block-size: 0;
    opacity: 0;
    transition:
      block-size 0.45s var(--expo-out),
      opacity 0.35s var(--expo-out),
      content-visibility 0.45s allow-discrete;
  }

  .faq-item[open]::details-content {
    block-size: auto;
    opacity: 1;
  }

  @starting-style {
    .faq-item[open]::details-content {
      block-size: 0;
      opacity: 0;
    }
  }

  /* Browsers without ::details-content still ease the open (close snaps). */
  @supports not selector(::details-content) {
    .faq-item__body {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.45s var(--expo-out);
    }

    .faq-item[open] .faq-item__body {
      grid-template-rows: 1fr;
    }

    .faq-item__body > * {
      min-height: 0;
      overflow: hidden;
    }

    .faq-item__answer {
      opacity: 0;
      translate: 0 -0.35rem;
      transition:
        opacity 0.3s var(--expo-out),
        translate 0.45s var(--expo-out);
    }

    .faq-item[open] .faq-item__answer {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item,
    .faq-item__question,
    .faq-item__icon,
    .faq-item::details-content,
    .faq-item__body,
    .faq-item__answer {
      transition: none;
    }
  }
</style>
