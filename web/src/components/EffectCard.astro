---
import EffectPreview from '@components/EffectPreview.astro'
import CopyIcon from '@components/icons/copy.astro'
import CheckIcon from '@components/icons/check.astro'

interface Props {
  effect: {
    id: string
    className: string
    name: string
    desc: string
    technique: string
    durationMs: number
    css: string
  }
  index: number
  hidden?: boolean
}

const { effect, index, hidden = false } = Astro.props
const copyId = `fx-copy-${effect.id}`
---

<li
  data-copy-scope
  class:list={['fx-card', !hidden && 'fx-enter']}
  data-fx={effect.id}
  data-class={effect.className}
  data-name={effect.id}
  data-technique={effect.technique}
  style={`--i:${index}`}
  hidden={hidden || undefined}
>
  <button
    type="button"
    class="fx-select"
    aria-label={`Select ${effect.id}. Preview plays on hover or focus. Click to copy the class.`}
  >
    <EffectPreview />
  </button>

  <div class="fx-meta">
    <span class="fx-name">{effect.id}</span>
    <code id={copyId} hidden>{effect.className}</code>
    <button
      type="button"
      class="fx-copy"
      data-copy={`#${copyId}`}
      data-toast={`Copied "${effect.id}"`}
      aria-label={`Copy class ${effect.className}`}
    >
      <span class="fx-copy__idle" aria-hidden="true">
        <CopyIcon size={13} />
      </span>
      <span class="fx-copy__done" aria-hidden="true">
        <CheckIcon size={13} />
      </span>
      <span class="sr-only" data-copy-label>Copy</span>
    </button>
  </div>
</li>

<style>
  .fx-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: transparent;
    overflow: visible;
  }

  .fx-card:hover :global(.fx-preview) {
    border-color: var(--line-strong);
  }

  .fx-select {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: center;
    cursor: pointer;
  }

  .fx-select:focus-visible {
    outline: none;
  }

  .fx-select:focus-visible :global(.fx-preview) {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .fx-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    margin-top: 0.75rem;
  }

  .fx-name {
    min-width: 0;
    overflow: hidden;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-overflow: ellipsis;
    white-space: nowrap;

    @media (width >= 40rem) {
      font-size: 0.75rem;
    }
  }

  .fx-copy {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    border-radius: 0.375rem;
    background: transparent;
    color: var(--ink-3);
    cursor: pointer;
  }

  .fx-copy:hover,
  .fx-card:is(:hover, :focus-within) .fx-copy {
    color: var(--ink);
  }

  .fx-copy:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .fx-copy__done {
    display: none;
  }

  .fx-copy[data-state='copied'] {
    color: var(--accent-text);
  }

  .fx-copy[data-state='copied'] .fx-copy__idle {
    display: none;
  }

  .fx-copy[data-state='copied'] .fx-copy__done {
    display: grid;
  }
</style>
