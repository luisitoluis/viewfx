---
import CloseIcon from '@components/icons/close.astro'
---

<!-- Native <dialog>: the focus trap, Escape key, inert background and focus
     restore all come from the platform. Content is injected by lib/dialog.js. -->
<dialog id="code-dialog" class="dialog" aria-labelledby="code-dialog-title">
  <div class="flex items-center justify-between gap-3 border-b border-line px-4 py-3">
    <h2 id="code-dialog-title" class="font-mono text-sm font-semibold"></h2>

    <form method="dialog">
      <button type="submit" class="inline-flex size-10 min-h-10 min-w-10 cursor-pointer items-center justify-center rounded-[0.625rem] border border-transparent text-ink-2 transition-colors hover:bg-inset hover:text-ink" aria-label="Close the code viewer">
        <CloseIcon />
      </button>
    </form>
  </div>

  <div
    data-dialog-body
    role="region"
    aria-labelledby="code-dialog-title"
    tabindex="0"
    class="max-h-[70dvh] overflow-auto"
  >
  </div>
</dialog>

<style>
  .dialog {
    margin: auto;
    width: min(46rem, calc(100vw - 2rem));
    max-height: min(46rem, calc(100dvh - 2rem));
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 1rem;
    background: var(--surface);
    color: var(--ink);
    overflow: hidden;
  }

  .dialog::backdrop {
    background: color-mix(in oklab, var(--paper) 70%, transparent);
    backdrop-filter: blur(6px);
  }

  .dialog[open] {
    @media (prefers-reduced-motion: no-preference) {
      animation: dialog-in 0.28s var(--expo-out) both;
    }
  }

  @keyframes dialog-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
  }
</style>
