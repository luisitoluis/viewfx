---
import SearchIcon from './icons/search.astro'
import CloseIcon from './icons/close.astro'
import { GIF_PRESETS } from '../data/gif.js'

interface Props {
  selectedHref?: string
}

const { selectedHref } = Astro.props
---

<div class="rounded-2xl border border-line bg-surface p-4">
  <label class="mb-2 block text-xs font-semibold tracking-wide text-ink-3 uppercase" for="gif-search">
    GIF
  </label>
  <div class="relative mb-3">
    <SearchIcon size={14} class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-ink-3" />
    <input
      id="gif-search"
      class="gif-search w-full min-h-11 rounded-[0.625rem] border border-line bg-surface pr-3.5 pl-10 font-mono text-[0.8125rem] text-ink placeholder:text-ink-3 focus-visible:border-accent"
      type="search"
      placeholder="Search GIFs"
      autocomplete="off"
    />
  </div>
  <div
    class="gif-list flex h-64 flex-col gap-0.5 overflow-y-auto overscroll-y-contain"
    role="listbox"
    aria-label="GIF masks"
  >
    {
      GIF_PRESETS.map((gif) => (
        <button
          type="button"
          role="option"
          data-gif={gif.id}
          data-name={gif.name}
          data-href={gif.href}
          aria-selected={gif.href === selectedHref ? 'true' : 'false'}
          class:list={[
            'effect-option min-h-10 rounded-lg px-3 py-2 text-left text-sm text-ink-2 transition-colors hover:bg-inset hover:text-ink',
            gif.href === selectedHref && 'is-selected'
          ]}
        >
          <span class="block font-mono text-[13px] font-semibold">{gif.id}</span>
          <span class="block text-[11px] text-ink-3">{gif.name}</span>
        </button>
      ))
    }
  </div>
  <div class="mt-3 border-t border-line pt-3">
    <label for="gif-url" class="mb-1.5 block text-xs font-semibold tracking-wide text-ink-3 uppercase">
      GIF link
    </label>
    <div class="flex items-center gap-2">
      <img id="gif-thumb" class="gif-ink size-10 shrink-0 rounded-lg object-cover" alt="" hidden />
      <div class="relative min-w-0 flex-1">
        <input
          id="gif-url"
          class="w-full min-h-11 rounded-[0.625rem] border border-line bg-surface py-2 pr-10 pl-3 font-mono text-[0.8125rem] text-ink placeholder:text-ink-3 focus-visible:border-accent"
          type="url"
          inputmode="url"
          autocomplete="off"
          spellcheck="false"
          placeholder="https://…/effect.gif"
        />
        <button
          type="button"
          id="gif-clear"
          class="absolute top-1/2 right-1 inline-flex size-8 -translate-y-1/2 items-center justify-center rounded-md text-ink-3 transition-colors hover:bg-inset hover:text-ink"
          aria-label="Remove GIF"
          hidden
        >
          <CloseIcon size={14} />
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .effect-option.is-selected {
    background: color-mix(in oklab, var(--accent) 14%, var(--inset));
    color: var(--accent-text);
    font-weight: 600;
  }
</style>
