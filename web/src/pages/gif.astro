---
import Layout from '@layouts/Layout.astro'
import Header from '@components/layout/Header.astro'
import Footer from '@components/layout/Footer.astro'
import PlayIcon from '@components/icons/play.astro'
import CopyIcon from '@components/icons/copy.astro'
import GifPicker from '@components/GifPicker.astro'
import GifTiming from '@components/GifTiming.astro'
import BackHome from '@components/ui/BackHome.astro'
import { SITE } from '@data/site'
import { GIF_DURATION, GIF_PRESETS } from '@data/gif.js'

const durations = Object.keys(GIF_DURATION)
const sizes = ['30%', '50%', '70%', '100%', 'cover']
const gifIds = GIF_PRESETS.map((gif) => gif.id)

const params = Astro.url.searchParams
const pick = (key: string, allowed: string[], fallback: string) => {
  const value = params.get(key)
  return value && allowed.includes(value) ? value : fallback
}

const gifFromQuery = params.get('gif')
const presetFromGif = GIF_PRESETS.find((gif) => gif.href === gifFromQuery)
const initialId = presetFromGif?.id ?? pick('e', gifIds, '')
const initial = {
  e: initialId,
  d: pick('d', durations, '3s'),
  size: pick('size', sizes, '50%'),
  gif: gifFromQuery || GIF_PRESETS.find((gif) => gif.id === initialId)?.href || ''
}

const initialDuration = GIF_DURATION[initial.d as keyof typeof GIF_DURATION] ?? '3s'
const initialHold = initial.size === 'cover' || initial.size === '100%' ? '100vmax' : `${initial.size.replace('%', '')}vmax`
const initialSnippet = `::view-transition-group(root) {
  animation-timing-function: var(--expo-in);
}

::view-transition-new(root) {
  mask: url('${initial.gif}') center / 0 no-repeat;
  animation: scale ${initialDuration};
  animation-fill-mode: both;
}

::view-transition-old(root),
.dark::view-transition-old(root) {
  animation: none;
  z-index: -1;
}

@keyframes scale {
  0% {
    mask-size: 0px;
  }
  10% {
    mask-size: ${initialHold};
  }
  90% {
    mask-size: ${initialHold};
  }
  100% {
    mask-size: 2000vmax;
  }
}`
---

<Layout
  title={`GIF studio — ${SITE.name}`}
  description="Mask a theme wipe with one GIF. Pick a preset or paste a link, set duration and mask size, then play it on the View Transitions API."
>
  <Header />
  <main id="main" class="pt-20 sm:pt-24" tabindex="-1">
  <div class="mx-auto w-full max-w-6xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="mb-8 max-w-2xl">
      <BackHome />
      <p class="mb-2 font-mono text-[0.6875rem] leading-none tracking-[0.14em] text-accent-text uppercase">GIF studio</p>
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Wipe between two GIFs</h1>
      <p class="mt-3 max-w-xl text-base leading-relaxed text-ink-2">
        Pick a GIF, tune duration and mask size, play it on the real View Transitions API, then
        copy the CSS or share the URL.
      </p>
    </div>

    <div
      id="gif-studio"
      class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,22rem)] lg:items-start xl:grid-cols-[minmax(0,1fr)_minmax(20rem,24rem)]"
    >
      <section
        class="flex min-h-112 flex-col overflow-hidden rounded-2xl border border-line bg-surface shadow-sm"
        aria-label="GIF mask preview"
      >
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-4 py-3">
          <p class="text-xs font-semibold tracking-wide text-ink-3 uppercase">Live page</p>
          <button
            type="button"
            id="play-btn"
            class="inline-flex min-h-9 items-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-xs font-semibold text-ink-2 transition-colors hover:border-accent hover:text-accent-text"
          >
            <PlayIcon size={14} />
            Play
          </button>
        </div>

        <div id="gif-live" class="relative flex min-h-[21.375rem] flex-1 flex-col overflow-hidden bg-paper">
          <div class="flex flex-1 flex-col justify-center gap-4 p-6 sm:p-8">
            <p class="text-sm font-bold text-ink">Theme</p>
            <p class="max-w-sm text-xs leading-relaxed text-ink-2">
              Play toggles light and dark on this surface. The GIF is only the mask.
            </p>
            <div class="grid max-w-sm grid-cols-2 gap-2" aria-hidden="true">
              <div class="h-16 rounded-lg bg-inset"></div>
              <div class="h-16 rounded-lg bg-surface"></div>
            </div>
          </div>
        </div>

        <div class="border-t border-line bg-inset px-4 py-3">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <p class="mb-1 text-[10px] font-semibold tracking-wider text-ink-3 uppercase">
                CSS
              </p>
              <code
                id="class-snippet"
                class="block max-h-48 overflow-auto overscroll-y-contain font-mono text-[12px] leading-relaxed whitespace-pre text-ink scrollbar-thin scrollbar-thumb-accent scrollbar-track-paper"
              >
                {initialSnippet}
              </code>
              <p class="mt-2 text-[10px] font-semibold tracking-wider text-ink-3 uppercase">
                Play
              </p>
              <code
                id="html-snippet"
                class="block overflow-x-auto font-mono text-[12px] leading-relaxed whitespace-pre text-ink-2"
              >
                {`if (!document.startViewTransition) switchTheme()
document.startViewTransition(switchTheme);`}
              </code>
            </div>
            <div class="flex shrink-0 flex-col gap-2 sm:flex-row">
              <button
                type="button"
                id="copy-classes"
                class="inline-flex min-h-9 items-center justify-center gap-1.5 rounded-full bg-ink px-3 py-1.5 text-xs font-semibold text-paper"
              >
                <CopyIcon size={13} />
                <span data-label>Copy</span>
              </button>
              <button
                type="button"
                id="copy-url"
                class="inline-flex min-h-9 items-center justify-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-xs font-semibold text-ink-2"
              >
                <span data-label>Share URL</span>
              </button>
            </div>
          </div>
        </div>
      </section>

      <aside class="flex flex-col gap-4 lg:sticky lg:top-24">
        <GifPicker selectedHref={initial.gif} />
        <GifTiming duration={initial.d} size={initial.size} durations={durations} sizes={sizes} />

        <p class="text-xs leading-relaxed text-ink-3">
          Pick a preset or paste a Tenor, Giphy, or any https URL. Transparency works best as a
          mask. One GIF for both light and dark.
        </p>
      </aside>
    </div>
  </div>
  </main>
  <Footer />
</Layout>

<script>
  import { initGifStudio } from '@lib/gif'
  initGifStudio()
</script>

<style>
  /* Own theme, so the wipe stays inside Live page. */
  #gif-live {
    color-scheme: light;
    --paper: #f9f7f3;
    --surface: #ffffff;
    --inset: #f2f0ea;
    --ink: #10141b;
    --ink-2: #4f5359;
    --ink-3: #7d8086;
    --line: #d6d9de;
    --line-strong: #b3b8bf;
  }

  #gif-live.dark {
    color-scheme: dark;
    --paper: #0b0e15;
    --surface: #12171f;
    --inset: #191e28;
    --ink: #f1f3f7;
    --ink-2: #aaaeb6;
    --ink-3: #82868e;
    --line: #282e38;
    --line-strong: #454e5b;
  }

</style>
