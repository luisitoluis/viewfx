---
import Layout from '@layouts/Layout.astro'
import Header from '@components/layout/Header.astro'
import Footer from '@components/layout/Footer.astro'
import PlayIcon from '@components/icons/play.astro'
import CopyIcon from '@components/icons/copy.astro'
import SearchIcon from '@components/icons/search.astro'
import BackHome from '@components/ui/BackHome.astro'
import { SITE } from '@data/site'
import { EFFECTS } from '@data/effects'
import { buildClasses } from '@lib/playground'
import {
  ANIMATION_DELAY,
  ANIMATION_DURATION,
  ANIMATION_STEPS,
  DEFAULT_DURATION_KEY
} from '@data/timing'

const effectIds = EFFECTS.map((effect) => effect.id)
const durations = Object.keys(ANIMATION_DURATION)
const delays = Object.keys(ANIMATION_DELAY)
const steps = Object.keys(ANIMATION_STEPS)

const params = Astro.url.searchParams
const pick = (key: string, allowed: string[], fallback: string) => {
  const value = params.get(key)
  return value && allowed.includes(value) ? value : fallback
}

const initial = {
  e: pick('e', effectIds, 'polygon'),
  d: pick('d', durations, DEFAULT_DURATION_KEY),
  delay: pick('delay', delays, '0'),
  s: pick('s', steps, 'none')
}

const playgroundData = {
  effects: effectIds,
  durations,
  delays,
  steps
}

const initialClasses = buildClasses(initial).join(' ')

const selectClass =
  'w-full min-h-11 rounded-xl border border-line bg-surface px-3 text-sm text-ink focus-visible:border-accent'
---

<Layout
  title={`Playground — ${SITE.name}`}
  description="Compose ViewFX theme transitions live: pick an effect, duration, delay and steps, play the wipe, then copy the class list or share the URL."
  effectClass={initialClasses}
>
  <Header />
  <main id="main" class="pt-20 sm:pt-24" tabindex="-1">
  <div class="mx-auto w-full max-w-6xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="mb-8 max-w-2xl">
      <BackHome />
      <p class="mb-2 font-mono text-[0.6875rem] leading-none tracking-[0.14em] text-accent-text uppercase">Playground</p>
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Compose transitions live</h1>
      <p class="mt-3 max-w-xl text-base leading-relaxed text-ink-2">
        Pick an effect, tune timing, play it on the real View Transitions API, then copy the
        classes or share the URL.
      </p>
    </div>

    <div
      id="playground"
      class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,22rem)] lg:items-start xl:grid-cols-[minmax(0,1fr)_minmax(20rem,24rem)]"
    >
      <section
        class="flex min-h-112 flex-col overflow-hidden rounded-2xl border border-line bg-surface shadow-sm"
        aria-label="Theme transition preview"
      >
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-4 py-3">
          <p class="text-xs font-semibold tracking-wide text-ink-3 uppercase">Live page</p>
          <button
            type="button"
            id="play-btn"
            class="inline-flex min-h-9 items-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-xs font-semibold text-ink-2 transition-colors hover:border-accent hover:text-accent-text"
          >
            <PlayIcon size={14} />
            Play
          </button>
        </div>

        <div id="fx-live" class="relative flex min-h-[21.375rem] flex-1 flex-col overflow-hidden bg-paper">
          <div class="flex flex-1 flex-col justify-center gap-4 p-6 sm:p-8">
            <p class="text-sm font-bold text-ink">Theme</p>
            <p class="max-w-sm text-xs leading-relaxed text-ink-2">
              Play toggles light and dark on this surface. The effect runs here.
            </p>
            <div class="grid max-w-sm grid-cols-2 gap-2" aria-hidden="true">
              <div class="h-16 rounded-lg bg-inset"></div>
              <div class="h-16 rounded-lg bg-surface"></div>
            </div>
          </div>
        </div>

        <div class="border-t border-line bg-inset px-4 py-3">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <p class="mb-1 text-[10px] font-semibold tracking-wider text-ink-3 uppercase">
                Class list
              </p>
              <code
                id="class-snippet"
                class="block overflow-x-auto font-mono text-[13px] leading-relaxed break-all text-ink"
              >
                {initial.e}-duration-{initial.d}
              </code>
              <p class="mt-2 text-[10px] font-semibold tracking-wider text-ink-3 uppercase">
                On &lt;html&gt;
              </p>
              <code
                id="html-snippet"
                class="block overflow-x-auto font-mono text-[12px] leading-relaxed break-all text-ink-2"
              >
                {`<html class="dark ${initial.e}-duration-${initial.d}">`}
              </code>
            </div>
            <div class="flex shrink-0 flex-col gap-2 sm:flex-row">
              <button
                type="button"
                id="copy-classes"
                class="inline-flex min-h-9 items-center justify-center gap-1.5 rounded-full bg-ink px-3 py-1.5 text-xs font-semibold text-paper"
              >
                <CopyIcon size={13} />
                <span data-label>Copy</span>
              </button>
              <button
                type="button"
                id="copy-url"
                class="inline-flex min-h-9 items-center justify-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-xs font-semibold text-ink-2"
              >
                <span data-label>Share URL</span>
              </button>
            </div>
          </div>
        </div>
      </section>

      <aside class="flex flex-col gap-4 lg:sticky lg:top-24">
        <div id="effect-picker" class="rounded-2xl border border-line bg-surface p-4">
          <label class="mb-2 block text-xs font-semibold tracking-wide text-ink-3 uppercase" for="effect-search">
            Effect
          </label>
          <div class="relative mb-3">
            <SearchIcon size={14} class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-ink-3" />
            <input
              id="effect-search"
              class="w-full min-h-11 rounded-[0.625rem] border border-line bg-surface pr-3.5 pl-10 font-mono text-[0.8125rem] text-ink placeholder:text-ink-3 focus-visible:border-accent"
              type="search"
              placeholder="Search effects"
              autocomplete="off"
            />
          </div>
          <div
            id="effect-list"
            class="flex max-h-64 flex-col gap-0.5 overflow-y-auto"
            role="listbox"
            aria-label="ViewFX effects"
          >
            {
              EFFECTS.map((effect) => (
                <button
                  type="button"
                  role="option"
                  data-effect={effect.id}
                  data-name={effect.name}
                  aria-selected={effect.id === initial.e ? 'true' : 'false'}
                  class:list={[
                    'effect-option min-h-10 rounded-lg px-3 py-2 text-left text-sm text-ink-2 transition-colors hover:bg-inset hover:text-ink',
                    effect.id === initial.e && 'is-selected'
                  ]}
                >
                  <span class="block font-mono text-[13px] font-semibold">{effect.id}</span>
                  <span class="block text-[11px] text-ink-3">{effect.name}</span>
                </button>
              ))
            }
          </div>
        </div>

        <div class="rounded-2xl border border-line bg-surface p-4">
          <div class="grid gap-3">
            <label class="block">
              <span class="mb-1.5 block text-xs font-semibold tracking-wide text-ink-3 uppercase">
                Duration
              </span>
              <select id="ctrl-duration" class={selectClass}>
                {durations.map((key) => (
                  <option value={key} selected={key === initial.d}>
                    {key}
                  </option>
                ))}
              </select>
            </label>
            <label class="block">
              <span class="mb-1.5 block text-xs font-semibold tracking-wide text-ink-3 uppercase">
                Delay
              </span>
              <select id="ctrl-delay" class={selectClass}>
                {delays.map((key) => (
                  <option value={key} selected={key === initial.delay}>
                    {key}
                  </option>
                ))}
              </select>
            </label>
            <label class="block">
              <span class="mb-1.5 block text-xs font-semibold tracking-wide text-ink-3 uppercase">
                Steps
              </span>
              <select id="ctrl-steps" class={selectClass}>
                {steps.map((key) => (
                  <option value={key} selected={key === initial.s}>
                    {key}
                  </option>
                ))}
              </select>
            </label>
          </div>
        </div>

        <p class="text-xs leading-relaxed text-ink-3">
          Tip: change any control to play the wipe and update the shareable URL. Use Play to
          toggle light and dark again.
        </p>
      </aside>
    </div>
  </div>

  <script type="application/json" id="playground-data" is:inline set:html={JSON.stringify(playgroundData)} />
  </main>
  <Footer />
</Layout>

<script>
  import { initPlayground } from '@lib/playground'
  initPlayground()
</script>

<style>
  .effect-option.is-selected {
    background: color-mix(in oklab, var(--accent) 14%, var(--inset));
    color: var(--accent-text);
    font-weight: 600;
  }

  #fx-live {
    color-scheme: light;
    --paper: #f9f7f3;
    --surface: #ffffff;
    --inset: #f2f0ea;
    --ink: #10141b;
    --ink-2: #4f5359;
    --ink-3: #7d8086;
    --line: #d6d9de;
    --line-strong: #b3b8bf;
  }

  #fx-live.dark {
    color-scheme: dark;
    --paper: #0b0e15;
    --surface: #12171f;
    --inset: #191e28;
    --ink: #f1f3f7;
    --ink-2: #aaaeb6;
    --ink-3: #82868e;
    --line: #282e38;
    --line-strong: #454e5b;
  }
</style>

<style is:global>
  html.fx-preview.theme-swap::view-transition-group(root),
  html.fx-preview.theme-swap::view-transition-old(root),
  html.fx-preview.theme-swap::view-transition-new(root) {
    animation: none !important;
    mask: none !important;
    -webkit-mask: none !important;
  }

  html.fx-preview.theme-swap::view-transition-group(fx-live) {
    animation-duration: var(--fx-duration-override, var(--fx-duration, 0.5s));
    animation-timing-function: var(--fx-ease-override, var(--fx-ease, var(--expo-out)));
    animation-delay: var(--fx-delay, 0s);
  }

  html.fx-preview.theme-swap::view-transition-old(fx-live) {
    animation: var(--fx-anim-old, fx-fade-out)
      var(--fx-duration-override, var(--fx-duration, 0.5s))
      var(--fx-ease-override, var(--fx-ease, var(--expo-out)))
      var(--fx-delay, 0s) both;
    z-index: var(--fx-old-z, auto);
    mix-blend-mode: normal;
  }

  html.fx-preview.theme-swap::view-transition-new(fx-live) {
    mask: var(--fx-mask, none) var(--fx-mask-position, center) / 0 no-repeat;
    mask-origin: content-box;
    animation: var(--fx-anim, fx-fade-in)
      var(--fx-duration-override, var(--fx-duration, 0.5s))
      var(--fx-ease-override, var(--fx-ease, var(--expo-out)))
      var(--fx-delay, 0s) both;
    mix-blend-mode: normal;
  }

  html.fx-preview.theme-swap.mosaic::view-transition-new(fx-live),
  html.fx-preview.theme-swap[class*='mosaic-duration']::view-transition-new(fx-live) {
    mask: none;
    -webkit-mask-image:
      repeating-linear-gradient(
        #0000 0,
        #0000 calc(6.25% - var(--fx-mosaic) * 8%),
        #fff calc(6.25% - var(--fx-mosaic) * 6.6%),
        #fff calc(6.25% + var(--fx-mosaic) * 6.6%),
        #0000 calc(6.25% + var(--fx-mosaic) * 8%),
        #0000 12.5%
      ),
      repeating-linear-gradient(
        90deg,
        #0000 0,
        #0000 calc(6.25% - var(--fx-mosaic) * 8%),
        #fff calc(6.25% - var(--fx-mosaic) * 6.6%),
        #fff calc(6.25% + var(--fx-mosaic) * 6.6%),
        #0000 calc(6.25% + var(--fx-mosaic) * 8%),
        #0000 12.5%
      );
    mask-image:
      repeating-linear-gradient(
        #0000 0,
        #0000 calc(6.25% - var(--fx-mosaic) * 8%),
        #fff calc(6.25% - var(--fx-mosaic) * 6.6%),
        #fff calc(6.25% + var(--fx-mosaic) * 6.6%),
        #0000 calc(6.25% + var(--fx-mosaic) * 8%),
        #0000 12.5%
      ),
      repeating-linear-gradient(
        90deg,
        #0000 0,
        #0000 calc(6.25% - var(--fx-mosaic) * 8%),
        #fff calc(6.25% - var(--fx-mosaic) * 6.6%),
        #fff calc(6.25% + var(--fx-mosaic) * 6.6%),
        #0000 calc(6.25% + var(--fx-mosaic) * 8%),
        #0000 12.5%
      );
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
</style>
