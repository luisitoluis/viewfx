{
  "name": "viewfx",
  "version": "0.0.8",
  "description": "Tailwind CSS v3/v4 plugin for View Transitions theme effects",
  "style": "./src/index.css",
  "main": "./src/plugin.cjs",
  "exports": {
    ".": {
      "style": "./src/index.css",
      "require": "./src/plugin.cjs",
      "import": "./src/plugin.js",
      "default": "./src/plugin.cjs"
    },
    "./index.css": "./src/index.css",
    "./plugin": {
      "require": "./src/plugin.cjs",
      "import": "./src/plugin.js",
      "default": "./src/plugin.cjs"
    }
  },
  "files": [
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuisitoLuis/viewfx.git"
  },
  "bugs": {
    "url": "https://github.com/LuisitoLuis/viewfx/issues"
  },
  "homepage": "https://viewfx.luismc.dev",
  "type": "module",
  "scripts": {
    "emit:masks": "node scripts/emit-masks.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "keywords": [
    "tailwind",
    "css",
    "view-transitions",
    "theme",
    "plugin"
  ],
  "author": "Luis Martinez (@luisitoluis)",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "tailwindcss": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@csstools/postcss-minify": "3.0.2",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.4",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.12.0",
    "postcss": "8.5.32",
    "prettier": "3.9.8",
    "prettier-config-standard": "7.0.0",
    "prettier-plugin-astro": "1.0.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.4",
    "tailwindcss-v3": "npm:tailwindcss@3.4.19",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
