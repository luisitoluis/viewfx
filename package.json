{
  "name": "viewfx",
  "version": "0.0.8",
  "description": "Tailwind CSS v3/v4 plugin for View Transitions theme effects",
  "style": "./src/index.css",
  "main": "./src/plugin.cjs",
  "exports": {
    ".": {
      "style": "./src/index.css",
      "require": "./src/plugin.cjs",
      "import": "./src/plugin.js",
      "default": "./src/plugin.cjs"
    },
    "./index.css": "./src/index.css",
    "./plugin": {
      "require": "./src/plugin.cjs",
      "import": "./src/plugin.js",
      "default": "./src/plugin.cjs"
    }
  },
  "files": [
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuisitoLuis/viewfx.git"
  },
  "homepage": "https://viewfx.luismc.dev",
  "type": "module",
  "scripts": {
    "emit:masks": "node scripts/emit-masks.mjs",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "keywords": [
    "tailwind",
    "css",
    "view-transitions",
    "theme",
    "plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "tailwindcss": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@csstools/postcss-minify": "3.0.2",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "tailwindcss-v3": "npm:tailwindcss@3.4.17",
    "vitest": "5.0.3"
  }
}
